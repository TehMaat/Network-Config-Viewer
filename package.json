{
  "name": "network-config-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Visualizzazione grafica dei backup di configurazione degli apparati di rete, tutta in locale.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @ncv/web",
    "build": "npm run build -w @ncv/web && npm run build -w @ncv/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @ncv/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build",
    "start": "npm run start -w @ncv/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
